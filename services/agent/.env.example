PORT=3005
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5433/dbname
REDIS_URL=redis://localhost:6380
JWT_SECRET=your_jwt_secret_here

# Tier 2 — OpenAI-compatible inference endpoint (e.g. Groq, Together AI, Fireworks)
TIER2_API_BASE=https://api.groq.com/openai/v1
TIER2_API_KEY=
TIER2_MODEL_NAME=llama3-8b-8192

# Tier 3 — Anthropic (frontier model)
TIER3_API_KEY=
TIER3_MODEL=claude-sonnet-4-6

# Optional overrides
TIER3_QUOTA_PER_DAY=5
MODEL_TIMEOUT_MS=10000

# ── AI modes for the web app (Opportunities guidance, Hidden Curriculum Decoder)
# Demo mode: a shared Groq key, read only from this server's environment. Leave
# empty to disable demo AI (bring-your-own-key still works). Never commit a value.
GROQ_API_KEY=
# Daily limits for the shared demo key
AI_DEMO_DAILY_LIMIT_PER_USER=20
AI_DEMO_DAILY_LIMIT_TOTAL=500
# Provider request timeout (keep below the gateway's AGENT_PROXY_TIMEOUT_MS)
AI_TIMEOUT_MS=25000
# Anthropic as a bring-your-own-key provider is OFF unless this is true. Its
# adapter has only been checked offline, not against the live API; enable it
# after a live check with a real key.
AI_ENABLE_ANTHROPIC=false
# Optional model overrides (defaults shown); users cannot choose models or URLs
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-opus-5-5
