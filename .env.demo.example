# Environment for the hosted demo backend (scripts/demo-start.js).
# On Render these are set by render.yaml; this file documents them and lets you
# run the same launcher locally:  node scripts/demo-start.js
# Never commit a real .env.demo: it is gitignored. Only this .example is tracked.

# --- Required -----------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/gbm_demo
REDIS_URL=redis://localhost:6379
JWT_SECRET=                 # long random string; Render generates it for you
PORT=10000                  # public gateway port (set by the host on Render)

# --- Required in production ---------------------------------------------------
# Comma-separated list of browser origins allowed to call the API (your Vercel URL).
ALLOWED_ORIGINS=https://your-demo.vercel.app

# --- Optional -----------------------------------------------------------------
# TRUST_PROXY=1             # proxy hops in front of the gateway (default 1; 0 if exposed directly)
# DEMO_RUN_WORKER=true      # set false to skip the intelligence worker and save memory (~80 MB)
# DEMO_RUN_AGENT=true       # set false to skip the AI agent (localhost:3005) and save memory (~75 MB)
# DEMO_HEAP_MB=96           # max JS heap per Node process (whole number >= 16; not a total RSS cap)
# AGENT_SERVICE_URL=        # default http://localhost:3005, the agent started by the launcher
# GROQ_API_KEY=             # shared demo AI key; leave unset to disable demo AI (own-key AI still works).
#                           # Set it in the Render dashboard only; never commit a value.

# --- Vercel (frontend) --------------------------------------------------------
# Set in the Vercel project settings, not here:
#   VITE_API_URL=https://your-demo-api.onrender.com   (no trailing slash, no /api)
